# Anthropic (chat/decision agent)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Plaid (bank sync) - get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
# comma-separated products, e.g. transactions
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Local app
DATABASE_URL=sqlite:///./finbot.db
APP_SECRET=change-me

# Weekly email recap (optional) - uses your own email account via an "app password",
# not your real login password. For Gmail: turn on 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=you@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=you@gmail.com
